FROM postgres:17

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
  && . /etc/os-release \
  && curl -fsSL https://packagecloud.io/timescale/timescaledb/gpgkey | gpg --dearmor -o /usr/share/keyrings/timescaledb.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/timescaledb.gpg] https://packagecloud.io/timescale/timescaledb/debian/ ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/timescaledb.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends timescaledb-2-postgresql-17 \
  && apt-get purge -y --auto-remove curl gnupg \
  && rm -rf /var/lib/apt/lists/*